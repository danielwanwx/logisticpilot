    "still:photo": "remotion still src/index.jsx ArchitecturePreview out/stills/01-photo-and-erp.png --frame=75 --image-format=png --overwrite",
    "still:reason": "remotion still src/index.jsx ArchitecturePreview out/stills/02-strands-agent.png --frame=255 --image-format=png --overwrite",
    "still:confirm": "remotion still src/index.jsx ArchitecturePreview out/stills/03-check-and-confirm.png --frame=420 --image-format=png --overwrite",
    "still:result": "remotion still src/index.jsx ArchitecturePreview out/stills/04-erpnext-readback.png --frame=640 --image-format=png --overwrite",
    "render:v2": "remotion render src/index.jsx OpeningArchitectureV2 out/opening-architecture-v2.mp4 --codec=h264 --pixel-format=yuv420p --crf=17 --concurrency=2 --overwrite",
    "still:v2:intro": "remotion still src/index.jsx OpeningArchitectureV2 out/stills/v2-01-context.png --frame=120 --image-format=png --overwrite",
    "still:v2:architecture": "remotion still src/index.jsx OpeningArchitectureV2 out/stills/v2-02-architecture.png --frame=815 --image-format=png --overwrite",
    "still:v2:goal": "remotion still src/index.jsx OpeningArchitectureV2 out/stills/v2-03-goal.png --frame=1300 --image-format=png --overwrite"
  },
  "dependencies": {
    "@remotion/cli": "4.0.524",
